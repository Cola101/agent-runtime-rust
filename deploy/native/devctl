#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROJECT_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)
LOCAL_ROOT=${AGENT_RUNTIME_LOCAL_ROOT:-"$PROJECT_ROOT/.local"}
POSTGRES_PORT=${AGENT_RUNTIME_LOCAL_POSTGRES_PORT:-54329}
NATS_PORT=${AGENT_RUNTIME_LOCAL_NATS_PORT:-4222}
NATS_MONITOR_PORT=${AGENT_RUNTIME_LOCAL_NATS_MONITOR_PORT:-8222}
DAEMONIZER=${AGENT_RUNTIME_DAEMONIZER:-"$SCRIPT_DIR/daemonize-service"}
NATS_VERSION=2.10.20
NATS_DARWIN_ARM64_ASSET_ID=189197479
NATS_DARWIN_ARM64_SHA256=eec96584d95e16590c846e1e224bbedfcc3916ef6ebad234e9ecfefaaa7e503b

fail() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

resolve_download_proxy() {
  DOWNLOAD_PROXY=${AGENT_RUNTIME_DOWNLOAD_PROXY:-}
  if [ -n "$DOWNLOAD_PROXY" ]; then
    return
  fi
  if command -v scutil >/dev/null 2>&1; then
    proxy_dump=$(scutil --proxy 2>/dev/null || true)
    proxy_host=$(printf '%s\n' "$proxy_dump" | awk '/HTTPProxy :/ {print $3; exit}')
    proxy_port=$(printf '%s\n' "$proxy_dump" | awk '/HTTPPort :/ {print $3; exit}')
    proxy_enabled=$(printf '%s\n' "$proxy_dump" | awk '/HTTPEnable :/ {print $3; exit}')
    if [ "$proxy_enabled" = "1" ] && [ -n "$proxy_host" ] && [ -n "$proxy_port" ]; then
      DOWNLOAD_PROXY="http://$proxy_host:$proxy_port"
    fi
  fi
}

validate_local_root() {
  case "$LOCAL_ROOT" in
    ""|/|"$PROJECT_ROOT") fail "unsafe local state root: $LOCAL_ROOT" ;;
  esac
  if [ "${HOME:-}" = "$LOCAL_ROOT" ]; then
    fail "local state root must not be the user home directory"
  fi
}

resolve_postgres_bin() {
  if [ -n "${AGENT_RUNTIME_POSTGRES_BIN_DIR:-}" ]; then
    POSTGRES_BIN_DIR=$AGENT_RUNTIME_POSTGRES_BIN_DIR
  elif command -v pg_ctl >/dev/null 2>&1; then
    POSTGRES_BIN_DIR=$(dirname -- "$(command -v pg_ctl)")
  else
    fail "native PostgreSQL tools are missing; pg_ctl was not found"
  fi
  for binary in initdb pg_ctl psql createdb; do
    [ -x "$POSTGRES_BIN_DIR/$binary" ] || fail "missing PostgreSQL binary: $POSTGRES_BIN_DIR/$binary"
  done
}

resolve_nats_server() {
  if [ -n "${AGENT_RUNTIME_NATS_SERVER_BIN:-}" ]; then
    NATS_SERVER_BIN=$AGENT_RUNTIME_NATS_SERVER_BIN
  elif [ -x "$LOCAL_ROOT/toolchain/nats-server" ]; then
    NATS_SERVER_BIN="$LOCAL_ROOT/toolchain/nats-server"
  elif command -v nats-server >/dev/null 2>&1; then
    NATS_SERVER_BIN=$(command -v nats-server)
  else
    fail "native nats-server is missing; run the project bootstrap command first"
  fi
  [ -x "$NATS_SERVER_BIN" ] || fail "nats-server is not executable: $NATS_SERVER_BIN"
}

prepare_directories() {
  validate_local_root
  trusted_workspace="$LOCAL_ROOT/state/workspaces/11111111-1111-4111-8111-111111111111/44444444-4444-4444-8444-444444444444"
  mkdir -p \
    "$LOCAL_ROOT/config" \
    "$LOCAL_ROOT/env" \
    "$LOCAL_ROOT/logs" \
    "$LOCAL_ROOT/run" \
    "$LOCAL_ROOT/secrets" \
    "$LOCAL_ROOT/state/postgres" \
    "$LOCAL_ROOT/state/nats" \
    "$LOCAL_ROOT/state/checkpoints" \
    "$trusted_workspace" \
    "$LOCAL_ROOT/tmp/postgres-socket"
  : > "$LOCAL_ROOT/.agent-runtime-local-root"
  chmod 700 "$LOCAL_ROOT/secrets"
  if [ ! -f "$trusted_workspace/README.txt" ]; then
    printf '%s\n' 'Agent Runtime native workspace: trusted read-only Tool fixture.' > \
      "$trusted_workspace/README.txt"
  fi
}

ensure_secret() {
  secret_path=$1
  if [ ! -s "$secret_path" ]; then
    command -v openssl >/dev/null 2>&1 || fail "openssl is required to generate local-only secrets"
    umask 077
    openssl rand -hex 24 > "$secret_path"
  fi
}

validate_local_identity() {
  identity_root=$1
  for relative in \
    identity.ready ca.crt ca.key \
    nats-server.crt nats-server.key \
    model-gateway.crt model-gateway.key \
    checkpoint-gateway.crt checkpoint-gateway.key \
    worker-client.crt worker-client.key \
    workload-private.pem workload-private.pkcs8.b64 workload-public.raw.b64 \
    skill-private.pem skill-private.pkcs8.b64 skill-public.raw.b64 \
    model-credential-private.pem model-credential-public.pem \
    local-jwt-private.pem local-jwt-public.pem \
    control-plane-truststore.p12 control-plane-truststore-password \
    nats-control-plane-password nats-worker-password; do
    [ -s "$identity_root/$relative" ] || fail "local identity is incomplete: $relative"
  done
  for certificate in nats-server model-gateway checkpoint-gateway worker-client; do
    openssl verify -CAfile "$identity_root/ca.crt" \
      "$identity_root/$certificate.crt" >/dev/null 2>&1 || \
      fail "local identity certificate verification failed: $certificate"
  done
  openssl pkey -in "$identity_root/workload-private.pem" -noout >/dev/null 2>&1 || \
    fail "local workload private key is invalid"
  openssl pkey -in "$identity_root/model-credential-private.pem" -check -noout >/dev/null 2>&1 || \
    fail "local model credential private key is invalid"
  openssl pkey -pubin -in "$identity_root/model-credential-public.pem" -noout >/dev/null 2>&1 || \
    fail "local model credential public key is invalid"
  model_credential_bits=$(openssl pkey -in "$identity_root/model-credential-private.pem" -text -noout 2>/dev/null | sed -n '1s/.*(\([0-9][0-9]*\) bit.*/\1/p')
  [ "${model_credential_bits:-0}" -ge 3072 ] || \
    fail "local model credential key must be RSA-3072 or stronger"
  openssl pkey -in "$identity_root/local-jwt-private.pem" -check -noout >/dev/null 2>&1 || \
    fail "local JWT private key is invalid"
  public_key_length=$(openssl base64 -d -A < "$identity_root/workload-public.raw.b64" | wc -c | tr -d ' ')
  [ "$public_key_length" = "32" ] || fail "local workload public key must contain 32 bytes"
  skill_public_key_length=$(openssl base64 -d -A < "$identity_root/skill-public.raw.b64" | wc -c | tr -d ' ')
  [ "$skill_public_key_length" = "32" ] || fail "local Skill public key must contain 32 bytes"
  truststore_password=$(cat "$identity_root/control-plane-truststore-password")
  keytool -list -storetype PKCS12 \
    -keystore "$identity_root/control-plane-truststore.p12" \
    -storepass "$truststore_password" >/dev/null 2>&1 || \
    fail "local control-plane truststore is invalid"
}

cleanup_identity_build() {
  if [ -n "${IDENTITY_BUILD_DIR:-}" ] && [ -d "$IDENTITY_BUILD_DIR" ]; then
    rm -rf -- "$IDENTITY_BUILD_DIR"
  fi
}

issue_local_certificate() {
  certificate_name=$1
  common_name=$2
  extended_usage=$3
  subject_alternative_names=$4
  openssl req -new -newkey rsa:2048 -nodes \
    -keyout "$IDENTITY_BUILD_DIR/$certificate_name.key" \
    -out "$IDENTITY_BUILD_DIR/$certificate_name.csr" \
    -subj "/CN=$common_name" >/dev/null 2>&1
  {
    printf 'basicConstraints=critical,CA:FALSE\n'
    printf 'keyUsage=critical,digitalSignature,keyEncipherment\n'
    printf 'extendedKeyUsage=%s\n' "$extended_usage"
    printf 'subjectAltName=%s\n' "$subject_alternative_names"
  } > "$IDENTITY_BUILD_DIR/$certificate_name.ext"
  openssl x509 -req \
    -in "$IDENTITY_BUILD_DIR/$certificate_name.csr" \
    -CA "$IDENTITY_BUILD_DIR/ca.crt" \
    -CAkey "$IDENTITY_BUILD_DIR/ca.key" \
    -CAserial "$IDENTITY_BUILD_DIR/ca.srl" \
    -CAcreateserial \
    -out "$IDENTITY_BUILD_DIR/$certificate_name.crt" \
    -days 365 -sha256 \
    -extfile "$IDENTITY_BUILD_DIR/$certificate_name.ext" >/dev/null 2>&1
  rm -f -- \
    "$IDENTITY_BUILD_DIR/$certificate_name.csr" \
    "$IDENTITY_BUILD_DIR/$certificate_name.ext"
}

prepare_local_identity() {
  command -v openssl >/dev/null 2>&1 || fail "openssl is required for local identity"
  command -v keytool >/dev/null 2>&1 || fail "keytool is required for the Java NATS truststore"
  prepare_directories
  identity_root="$LOCAL_ROOT/secrets/identity"
  if [ -f "$identity_root/identity.ready" ]; then
    validate_local_identity "$identity_root"
    printf 'native development identity is already valid\n'
    return
  fi
  [ ! -e "$identity_root" ] || fail "refusing to replace an incomplete local identity; run clean first"

  IDENTITY_BUILD_DIR="$LOCAL_ROOT/tmp/identity-build-$$"
  cleanup_identity_build
  mkdir -p "$IDENTITY_BUILD_DIR"
  chmod 700 "$IDENTITY_BUILD_DIR"
  trap cleanup_identity_build EXIT HUP INT TERM
  umask 077

  openssl req -x509 -newkey rsa:2048 -nodes \
    -keyout "$IDENTITY_BUILD_DIR/ca.key" \
    -out "$IDENTITY_BUILD_DIR/ca.crt" \
    -days 365 -sha256 \
    -subj '/CN=Agent Runtime Local Development CA' \
    -addext 'basicConstraints=critical,CA:TRUE' \
    -addext 'keyUsage=critical,keyCertSign,cRLSign' >/dev/null 2>&1
  issue_local_certificate \
    nats-server nats.local serverAuth \
    'DNS:nats.local,DNS:localhost,IP:127.0.0.1'
  issue_local_certificate \
    model-gateway model-gateway.local serverAuth \
    'DNS:model-gateway.local,DNS:localhost,IP:127.0.0.1'
  issue_local_certificate \
    checkpoint-gateway checkpoint-gateway.local serverAuth \
    'DNS:checkpoint-gateway.local,DNS:localhost,IP:127.0.0.1'
  issue_local_certificate \
    worker-client runtime-worker.local clientAuth \
    'DNS:runtime-worker.local'

  openssl genpkey -algorithm ED25519 \
    -out "$IDENTITY_BUILD_DIR/workload-private.pem" >/dev/null 2>&1
  openssl pkey -in "$IDENTITY_BUILD_DIR/workload-private.pem" -outform DER | \
    openssl base64 -A > "$IDENTITY_BUILD_DIR/workload-private.pkcs8.b64"
  printf '\n' >> "$IDENTITY_BUILD_DIR/workload-private.pkcs8.b64"
  openssl pkey -in "$IDENTITY_BUILD_DIR/workload-private.pem" -pubout -outform DER | \
    tail -c 32 | openssl base64 -A > "$IDENTITY_BUILD_DIR/workload-public.raw.b64"
  printf '\n' >> "$IDENTITY_BUILD_DIR/workload-public.raw.b64"

  openssl genpkey -algorithm ED25519 \
    -out "$IDENTITY_BUILD_DIR/skill-private.pem" >/dev/null 2>&1
  openssl pkey -in "$IDENTITY_BUILD_DIR/skill-private.pem" -outform DER | \
    openssl base64 -A > "$IDENTITY_BUILD_DIR/skill-private.pkcs8.b64"
  printf '\n' >> "$IDENTITY_BUILD_DIR/skill-private.pkcs8.b64"
  openssl pkey -in "$IDENTITY_BUILD_DIR/skill-private.pem" -pubout -outform DER | \
    tail -c 32 | openssl base64 -A > "$IDENTITY_BUILD_DIR/skill-public.raw.b64"
  printf '\n' >> "$IDENTITY_BUILD_DIR/skill-public.raw.b64"

  openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 \
    -out "$IDENTITY_BUILD_DIR/local-jwt-private.pem" >/dev/null 2>&1
  openssl pkey -in "$IDENTITY_BUILD_DIR/local-jwt-private.pem" -pubout \
    -out "$IDENTITY_BUILD_DIR/local-jwt-public.pem" >/dev/null 2>&1

  openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 \
    -out "$IDENTITY_BUILD_DIR/model-credential-private.pem" >/dev/null 2>&1
  openssl pkey -in "$IDENTITY_BUILD_DIR/model-credential-private.pem" -pubout \
    -out "$IDENTITY_BUILD_DIR/model-credential-public.pem" >/dev/null 2>&1

  openssl rand -hex 24 > "$IDENTITY_BUILD_DIR/control-plane-truststore-password"
  openssl rand -hex 24 > "$IDENTITY_BUILD_DIR/nats-control-plane-password"
  openssl rand -hex 24 > "$IDENTITY_BUILD_DIR/nats-worker-password"
  truststore_password=$(cat "$IDENTITY_BUILD_DIR/control-plane-truststore-password")
  keytool -importcert -noprompt \
    -alias agent-runtime-local-ca \
    -file "$IDENTITY_BUILD_DIR/ca.crt" \
    -keystore "$IDENTITY_BUILD_DIR/control-plane-truststore.p12" \
    -storetype PKCS12 \
    -storepass "$truststore_password" >/dev/null 2>&1
  rm -f -- "$IDENTITY_BUILD_DIR/ca.srl"
  printf 'v1\n' > "$IDENTITY_BUILD_DIR/identity.ready"
  chmod 600 "$IDENTITY_BUILD_DIR"/*
  mv "$IDENTITY_BUILD_DIR" "$identity_root"
  trap - EXIT HUP INT TERM
  validate_local_identity "$identity_root"
  printf 'native development identity generated\n'
}

base64url() {
  openssl base64 -A | tr '+/' '-_' | tr -d '='
}

cleanup_access_token_build() {
  if [ -n "${ACCESS_TOKEN_BUILD_DIR:-}" ] && [ -d "$ACCESS_TOKEN_BUILD_DIR" ]; then
    rm -rf -- "$ACCESS_TOKEN_BUILD_DIR"
  fi
}

refresh_local_access_token() {
  identity_root="$LOCAL_ROOT/secrets/identity"
  [ -s "$identity_root/local-jwt-private.pem" ] || fail "local JWT signing key is missing"
  issued_at=$(date +%s)
  expires_at=$((issued_at + 86400))
  header=$(printf '%s' '{"alg":"RS256","typ":"JWT"}' | base64url)
  payload=$(printf '%s' "{\"iss\":\"agent-runtime-local\",\"sub\":\"local-developer\",\"aud\":\"agent-runtime-api\",\"tenant_id\":\"11111111-1111-4111-8111-111111111111\",\"application_id\":\"22222222-2222-4222-8222-222222222222\",\"scope\":\"resources:read resources:write runs:read runs:write approvals:read approvals:write\",\"iat\":$issued_at,\"exp\":$expires_at}" | base64url)
  signing_input="$header.$payload"

  ACCESS_TOKEN_BUILD_DIR="$LOCAL_ROOT/tmp/access-token-$$"
  cleanup_access_token_build
  mkdir -p "$ACCESS_TOKEN_BUILD_DIR"
  chmod 700 "$ACCESS_TOKEN_BUILD_DIR"
  trap cleanup_access_token_build EXIT HUP INT TERM
  printf '%s' "$signing_input" > "$ACCESS_TOKEN_BUILD_DIR/signing-input"
  openssl dgst -sha256 -sign "$identity_root/local-jwt-private.pem" \
    -out "$ACCESS_TOKEN_BUILD_DIR/signature" "$ACCESS_TOKEN_BUILD_DIR/signing-input"
  signature=$(base64url < "$ACCESS_TOKEN_BUILD_DIR/signature")
  umask 077
  printf '%s\n' "$signing_input.$signature" > "$LOCAL_ROOT/secrets/local-access-token"
  chmod 600 "$LOCAL_ROOT/secrets/local-access-token"
  cleanup_access_token_build
  trap - EXIT HUP INT TERM
}

write_native_environment() {
