      "file:$identity_root/local-jwt-public.pem"
    printf "export AGENT_RUNTIME_LOCAL_GRPC_CA_CERT='%s'\n" "$identity_root/ca.crt"
    printf "export AGENT_RUNTIME_LOCAL_MODEL_GATEWAY_CERT='%s'\n" "$identity_root/model-gateway.crt"
    printf "export AGENT_RUNTIME_LOCAL_MODEL_GATEWAY_KEY='%s'\n" "$identity_root/model-gateway.key"
    printf "export AGENT_RUNTIME_LOCAL_CHECKPOINT_GATEWAY_CERT='%s'\n" "$identity_root/checkpoint-gateway.crt"
    printf "export AGENT_RUNTIME_LOCAL_CHECKPOINT_GATEWAY_KEY='%s'\n" "$identity_root/checkpoint-gateway.key"
