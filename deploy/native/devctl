      printf "export AGENT_RUNTIME_%s_NATS_SECURITY_TRUSTSTORE_PATH='%s'\n" "$component" "$identity_root/control-plane-truststore.p12"
      printf "export AGENT_RUNTIME_%s_NATS_SECURITY_TRUSTSTORE_PASSWORD='%s'\n" "$component" "$truststore_password"
