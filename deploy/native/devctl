    printf "export AGENT_RUNTIME_WORKSPACE_ROOT='%s'\n" "$LOCAL_ROOT/state/workspaces"
  } > "$environment_file"
}

postgres_running() {
  "$POSTGRES_BIN_DIR/pg_ctl" -D "$LOCAL_ROOT/state/postgres" status >/dev/null 2>&1
}

start_postgres() {
  postgres_data="$LOCAL_ROOT/state/postgres"
  postgres_password_file="$LOCAL_ROOT/secrets/postgres-password"
  if [ ! -f "$postgres_data/PG_VERSION" ]; then
    "$POSTGRES_BIN_DIR/initdb" \
      -D "$postgres_data" \
      --encoding=UTF8 \
      --username=agent_runtime_owner \
      --pwfile="$postgres_password_file" \
      --auth-local=trust \
      --auth-host=scram-sha-256 >/dev/null
  fi
  if ! postgres_running; then
    "$POSTGRES_BIN_DIR/pg_ctl" \
      -D "$postgres_data" \
      -l "$LOCAL_ROOT/logs/postgres.log" \
      -o "-h 127.0.0.1 -p $POSTGRES_PORT -c unix_socket_directories=''" \
      start -w >/dev/null
  fi
  if ! PGPASSWORD=$(cat "$postgres_password_file") "$POSTGRES_BIN_DIR/psql" \
      -h 127.0.0.1 -p "$POSTGRES_PORT" -U agent_runtime_owner -d postgres \
      -Atqc "select 1 from pg_database where datname='agent_runtime'" | grep -qx 1; then
    PGPASSWORD=$(cat "$postgres_password_file") \
      "$POSTGRES_BIN_DIR/createdb" \
      -h 127.0.0.1 -p "$POSTGRES_PORT" -U agent_runtime_owner agent_runtime
  fi
}

nats_running() {
  [ -s "$LOCAL_ROOT/run/nats.pid" ] || return 1
  nats_pid=$(cat "$LOCAL_ROOT/run/nats.pid")
  kill -0 "$nats_pid" 2>/dev/null
}

write_nats_config() {
  identity_root="$LOCAL_ROOT/secrets/identity"
  nats_control_password=$(cat "$identity_root/nats-control-plane-password")
  nats_worker_password=$(cat "$identity_root/nats-worker-password")
  command -v htpasswd >/dev/null 2>&1 || fail "htpasswd is required to hash local NATS passwords"
  nats_control_hash=$(htpasswd -bnBC 10 '' "$nats_control_password" | tr -d ':\n')
  nats_worker_hash=$(htpasswd -bnBC 10 '' "$nats_worker_password" | tr -d ':\n')
  case "$nats_control_hash:$nats_worker_hash" in
    \$2[aby]\$*:\$2[aby]\$*) ;;
    *) fail "failed to generate bcrypt NATS passwords" ;;
  esac
  {
    printf 'listen: 127.0.0.1:%s\n' "$NATS_PORT"
    printf 'http_port: %s\n' "$NATS_MONITOR_PORT"
    printf 'jetstream {\n'
    printf '  store_dir: "%s/state/nats"\n' "$LOCAL_ROOT"
    printf '  max_memory_store: 256MB\n'
    printf '  max_file_store: 1GB\n'
    printf '}\n'
    printf 'tls {\n'
    printf '  cert_file: "%s/nats-server.crt"\n' "$identity_root"
    printf '  key_file: "%s/nats-server.key"\n' "$identity_root"
    printf '  ca_file: "%s/ca.crt"\n' "$identity_root"
    printf '  timeout: 2\n'
    printf '}\n'
    printf 'authorization {\n'
    printf '  users: [\n'
    printf '    {\n'
    printf '      user: "control-plane"\n'
    printf '      password: "%s"\n' "$nats_control_hash"
    printf '      permissions: {\n'
    printf '        publish: ["runtime.control.>", "runtime.execution.>", "$JS.API.>", "$JS.ACK.>", "_INBOX.>"]\n'
    printf '        subscribe: ["runtime.control.>", "runtime.worker.>", "_INBOX.>"]\n'
    printf '      }\n'
    printf '    },\n'
    printf '    {\n'
    printf '      user: "runtime-worker"\n'
    printf '      password: "%s"\n' "$nats_worker_hash"
    printf '      permissions: {\n'
    printf '        publish: ["runtime.worker.>", "$JS.API.STREAM.INFO.RUNTIME_EXECUTION", "$JS.API.STREAM.INFO.RUNTIME_WORKER", "$JS.API.CONSUMER.INFO.RUNTIME_EXECUTION.>", "$JS.API.CONSUMER.CREATE.RUNTIME_EXECUTION.>", "$JS.API.CONSUMER.DURABLE.CREATE.RUNTIME_EXECUTION.>", "$JS.API.CONSUMER.MSG.NEXT.RUNTIME_EXECUTION.>", "$JS.ACK.RUNTIME_EXECUTION.>", "_INBOX.>"]\n'
    printf '        subscribe: ["runtime.execution.>", "$JS.FC.>", "_INBOX.>"]\n'
    printf '      }\n'
    printf '    }\n'
    printf '  ]\n'
    printf '}\n'
  } > "$LOCAL_ROOT/config/nats.conf"
}

cleanup_bootstrap() {
  if [ -n "${BOOTSTRAP_DIR:-}" ] && [ -d "$BOOTSTRAP_DIR" ]; then
    rm -rf -- "$BOOTSTRAP_DIR"
  fi
}

bootstrap_native_tools() {
  validate_local_root
  case "$(uname -s)-$(uname -m)" in
    Darwin-arm64) ;;
    *) fail "native bootstrap currently supports only macOS ARM64" ;;
  esac
  prepare_directories
  resolve_download_proxy
  mkdir -p "$LOCAL_ROOT/toolchain" "$LOCAL_ROOT/tmp"
  installed="$LOCAL_ROOT/toolchain/nats-server"
  if [ -x "$installed" ] && "$installed" --version 2>&1 | grep -q "v$NATS_VERSION"; then
    printf 'native nats-server v%s is already installed\n' "$NATS_VERSION"
    return
  fi

  # `auto` prefers the pinned archive. Both paths produce the same binary, but
  # they do not fail the same way: the archive is one download verified against
  # a SHA256 pinned in this repository, while `go install` needs
  # proxy.golang.org and sum.golang.org reachable and healthy at that moment.
  # On at least one developer network they were not -- three attempts, three
  # different failures -- while the archive succeeded first try. Preferring Go
  # turned a working setup into a reported blocker.
  #
  # The Go path stays and stays selectable with `go`; it is only no longer the
  # default. The archive is also the stronger supply-chain story, because the
  # digest is a constant here rather than whatever a service returns today.
  bootstrap_method=${AGENT_RUNTIME_NATS_BOOTSTRAP_METHOD:-auto}
  if [ "$bootstrap_method" = "go" ] && command -v go >/dev/null 2>&1; then
    mkdir -p "$LOCAL_ROOT/cache/go/pkg/mod" "$LOCAL_ROOT/cache/go/build"
    GOBIN="$LOCAL_ROOT/toolchain" \
      GOMODCACHE="$LOCAL_ROOT/cache/go/pkg/mod" \
      GOCACHE="$LOCAL_ROOT/cache/go/build" \
      GOPROXY="https://proxy.golang.org,direct" \
      GOSUMDB="sum.golang.org" \
      HTTP_PROXY="$DOWNLOAD_PROXY" \
      HTTPS_PROXY="$DOWNLOAD_PROXY" \
      ALL_PROXY="$DOWNLOAD_PROXY" \
      go install "github.com/nats-io/nats-server/v2@v$NATS_VERSION"
    version_output=$($installed --version 2>&1)
    printf '%s\n' "$version_output" | grep -q "v$NATS_VERSION" || fail "unexpected nats-server version"
    printf 'built native nats-server v%s with project-local Go caches\n' "$NATS_VERSION"
    return
  fi

  BOOTSTRAP_DIR="$LOCAL_ROOT/tmp/nats-bootstrap"
  cleanup_bootstrap
  mkdir -p "$BOOTSTRAP_DIR"
  trap cleanup_bootstrap EXIT HUP INT TERM
  archive="$BOOTSTRAP_DIR/nats-server.tar.gz"
  expected_sha=${AGENT_RUNTIME_NATS_ARCHIVE_SHA256:-$NATS_DARWIN_ARM64_SHA256}
  if [ -n "${AGENT_RUNTIME_NATS_ARCHIVE_PATH:-}" ]; then
    cp "$AGENT_RUNTIME_NATS_ARCHIVE_PATH" "$archive"
  else
    command -v curl >/dev/null 2>&1 || fail "curl is required to download the pinned native nats-server"
    HTTP_PROXY="$DOWNLOAD_PROXY" HTTPS_PROXY="$DOWNLOAD_PROXY" ALL_PROXY="$DOWNLOAD_PROXY" \
    curl --fail --location --silent --show-error \
      --connect-timeout 10 \
      --max-time 120 \
      --retry 2 \
      --retry-all-errors \
      -H 'Accept: application/octet-stream' \
      "https://api.github.com/repos/nats-io/nats-server/releases/assets/$NATS_DARWIN_ARM64_ASSET_ID" \
      -o "$archive"
  fi
  actual_sha=$(openssl dgst -sha256 "$archive" | awk '{print $2}')
  if [ "$actual_sha" != "$expected_sha" ]; then
    fail "nats-server archive checksum mismatch"
  fi
  tar -xzf "$archive" -C "$BOOTSTRAP_DIR"
  extracted="$BOOTSTRAP_DIR/nats-server-v$NATS_VERSION-darwin-arm64/nats-server"
  [ -x "$extracted" ] || fail "downloaded archive does not contain nats-server"
  version_output=$($extracted --version 2>&1)
  printf '%s\n' "$version_output" | grep -q "v$NATS_VERSION" || fail "unexpected nats-server version"
  cp "$extracted" "$installed"
  chmod 755 "$installed"
  cleanup_bootstrap
  trap - EXIT HUP INT TERM
  printf 'installed native nats-server v%s\n' "$NATS_VERSION"
}

start_nats() {
  if nats_running; then
    return
  fi
  rm -f "$LOCAL_ROOT/run/nats.pid"
  rm -f "$LOCAL_ROOT/run/nats.pgid"
  write_nats_config
  "$NATS_SERVER_BIN" -t -c "$LOCAL_ROOT/config/nats.conf" >/dev/null 2>&1 || \
    fail "native NATS configuration is invalid"
  launch_mode=${AGENT_RUNTIME_NATS_LAUNCH_MODE:-daemon}
  case "$launch_mode" in
    daemon)
      [ -x "$DAEMONIZER" ] || fail "native daemonizer is unavailable: $DAEMONIZER"
      "$DAEMONIZER" nats "$LOCAL_ROOT" "$NATS_SERVER_BIN" \
        -c "$LOCAL_ROOT/config/nats.conf" \
        -P "$LOCAL_ROOT/run/nats.pid"
      ;;
    launchctl)
      command -v launchctl >/dev/null 2>&1 || fail "launchctl is required for detached native NATS"
      root_digest=$(printf '%s' "$LOCAL_ROOT" | openssl dgst -sha256 | awk '{print substr($2,1,16)}')
      nats_label="com.agent-runtime.local.nats.$(id -u).$root_digest"
      printf '%s\n' "$nats_label" > "$LOCAL_ROOT/run/nats.launchd-label"
      launchctl remove "$nats_label" >/dev/null 2>&1 || true
      launchctl submit \
        -l "$nats_label" \
        -p "$NATS_SERVER_BIN" \
        -o "$LOCAL_ROOT/logs/nats.stdout.log" \
        -e "$LOCAL_ROOT/logs/nats.stderr.log" \
        -- nats-server -c "$LOCAL_ROOT/config/nats.conf" \
        -P "$LOCAL_ROOT/run/nats.pid" >/dev/null
      ;;
    direct)
      nohup "$NATS_SERVER_BIN" -c "$LOCAL_ROOT/config/nats.conf" \
        -P "$LOCAL_ROOT/run/nats.pid" \
        </dev/null > "$LOCAL_ROOT/logs/nats.log" 2>&1 &
      ;;
    *) fail "unsupported NATS launch mode: $launch_mode" ;;
  esac
  attempts=0
  while ! nats_running && [ "$attempts" -lt 50 ]; do
    sleep 0.1
    attempts=$((attempts + 1))
  done
  if ! nats_running; then
    if [ -s "$LOCAL_ROOT/run/nats.launchd-label" ]; then
      launchctl remove "$(cat "$LOCAL_ROOT/run/nats.launchd-label")" >/dev/null 2>&1 || true
    fi
    stop_nats
    fail "nats-server exited during startup; inspect $LOCAL_ROOT/logs/nats.stderr.log"
  fi
}

stop_nats() {
  nats_pgid=""
  if [ -s "$LOCAL_ROOT/run/nats.pgid" ]; then
    nats_pgid=$(cat "$LOCAL_ROOT/run/nats.pgid")
    case "$nats_pgid" in *[!0-9]*|'') nats_pgid="" ;; esac
  fi
  if [ -s "$LOCAL_ROOT/run/nats.pid" ]; then
    nats_pid=$(cat "$LOCAL_ROOT/run/nats.pid")
    if kill -0 "$nats_pid" 2>/dev/null; then
      current_pgid=$(ps -o pgid= -p $$ | tr -d ' ')
      if [ -n "$nats_pgid" ] && [ "$nats_pgid" -gt 1 ] && [ "$nats_pgid" != "$current_pgid" ]; then
        /bin/kill -TERM "-$nats_pgid" 2>/dev/null || true
      else
        kill "$nats_pid" 2>/dev/null || true
      fi
      attempts=0
      while kill -0 "$nats_pid" 2>/dev/null && [ "$attempts" -lt 50 ]; do
        sleep 0.1
        attempts=$((attempts + 1))
      done
      if kill -0 "$nats_pid" 2>/dev/null; then
        if [ -n "$nats_pgid" ] && [ "$nats_pgid" -gt 1 ] && [ "$nats_pgid" != "$current_pgid" ]; then
          /bin/kill -KILL "-$nats_pgid" 2>/dev/null || true
        else
          kill -KILL "$nats_pid" 2>/dev/null || true
        fi
      fi
    fi
  fi
  if [ -s "$LOCAL_ROOT/run/nats.launchd-label" ]; then
    launchctl remove "$(cat "$LOCAL_ROOT/run/nats.launchd-label")" >/dev/null 2>&1 || true
  fi
  rm -f "$LOCAL_ROOT/run/nats.pid" "$LOCAL_ROOT/run/nats.pgid" \
    "$LOCAL_ROOT/run/nats.launchd-label"
}

stop_postgres() {
  resolve_postgres_bin
  if [ -f "$LOCAL_ROOT/state/postgres/PG_VERSION" ] && postgres_running; then
    "$POSTGRES_BIN_DIR/pg_ctl" -D "$LOCAL_ROOT/state/postgres" stop -m fast -w >/dev/null
  fi
}

start_infra() {
  resolve_postgres_bin
  resolve_nats_server
  prepare_directories
  prepare_local_identity
  refresh_local_access_token
  ensure_secret "$LOCAL_ROOT/secrets/postgres-password"
  ensure_secret "$LOCAL_ROOT/secrets/management-scrape-password"
  write_native_environment
  start_postgres
  start_nats
  printf 'native infrastructure started\n'
}

stop_all() {
  validate_local_root
  if [ ! -d "$LOCAL_ROOT" ]; then
    printf 'native development environment is already stopped\n'
    return
  fi
  [ -f "$LOCAL_ROOT/.agent-runtime-local-root" ] || fail "refusing to stop unmarked directory: $LOCAL_ROOT"
  stop_nats
  stop_postgres
  printf 'native infrastructure stopped\n'
}

status_all() {
  validate_local_root
  resolve_postgres_bin
  if [ -f "$LOCAL_ROOT/state/postgres/PG_VERSION" ] && postgres_running; then
    printf 'postgresql: running\n'
  else
    printf 'postgresql: stopped\n'
  fi
  if nats_running; then
    printf 'nats: running\n'
  else
    printf 'nats: stopped\n'
  fi
}

clean_all() {
  validate_local_root
  if [ -d "$LOCAL_ROOT" ]; then
    [ -f "$LOCAL_ROOT/.agent-runtime-local-root" ] || fail "refusing to clean unmarked directory: $LOCAL_ROOT"
    stop_all
    find "$LOCAL_ROOT" -type d -exec chmod u+rwx {} +
    find "$LOCAL_ROOT" -mindepth 1 -maxdepth 1 \
      ! -name '.agent-runtime-local-root' -exec rm -rf -- {} +
    rm -f -- "$LOCAL_ROOT/.agent-runtime-local-root"
    rmdir -- "$LOCAL_ROOT"
  fi
  if [ "${AGENT_RUNTIME_PRESERVE_BUILD_OUTPUTS:-false}" != "true" ]; then
    rm -rf -- \
      "$PROJECT_ROOT/node_modules" \
      "$PROJECT_ROOT/control-plane/target" \
      "$PROJECT_ROOT/runtime/target" \
      "$PROJECT_ROOT/console/node_modules" \
      "$PROJECT_ROOT/console/dist" \
      "$PROJECT_ROOT/console/coverage" \
      "$PROJECT_ROOT/console/test-results" \
      "$PROJECT_ROOT/console/playwright-report" \
      "$PROJECT_ROOT/graphify-out"
  fi
  printf 'native development state and build outputs cleaned\n'
}

case "${1:-}" in
  bootstrap) bootstrap_native_tools ;;
  prepare-identity) prepare_local_identity; refresh_local_access_token ;;
  start-infra) start_infra ;;
  stop) stop_all ;;
  status) status_all ;;
  clean) clean_all ;;
  *)
    printf 'usage: %s {bootstrap|prepare-identity|start-infra|stop|status|clean}\n' "$0" >&2
    exit 2
    ;;
esac
